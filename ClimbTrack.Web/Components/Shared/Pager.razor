@if (TotalPages > 1)
{
    <nav aria-label="Pagination">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Page <= 1 ? "disabled" : "")">
                <button type="button" class="page-link" aria-label="Previous page" disabled="@(Page <= 1)" @onclick="() => Go(Page - 1)">Previous</button>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @Page of @TotalPages</span></li>
            <li class="page-item @(Page >= TotalPages ? "disabled" : "")">
                <button type="button" class="page-link" aria-label="Next page" disabled="@(Page >= TotalPages)" @onclick="() => Go(Page + 1)">Next</button>
            </li>
        </ul>
    </nav>
}

@code {
    [Parameter, EditorRequired] public int Page { get; set; }
    [Parameter, EditorRequired] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }

    private Task Go(int page) => PageChanged.InvokeAsync(Math.Clamp(page, 1, TotalPages));
}
