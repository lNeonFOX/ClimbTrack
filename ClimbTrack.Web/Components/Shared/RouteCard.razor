<article class="card route-card h-100">
    @if (!string.IsNullOrWhiteSpace(Route.ImageUrl))
    {
        <img src="@Route.ImageUrl" class="card-img-top" alt="" loading="lazy" />
    }
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h3 class="h5 mb-0"><a href="routes/@Route.Id">@Route.Name</a></h3>
            <GradeBadge Grade="Route.Grade" />
        </div>
        <p class="text-muted small mb-2">@Route.WallType wall</p>
        <p class="flex-grow-1">@Route.Description</p>
        @if (ShowActions)
        {
            <div><a class="btn btn-sm btn-primary" href="journal?routeId=@Route.Id">Log climb</a></div>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public ClimbingRoute Route { get; set; } = default!;

    /// <summary>Show the "Log climb" action (only meaningful for signed-in users).</summary>
    [Parameter] public bool ShowActions { get; set; }
}
