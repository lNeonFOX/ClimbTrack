@page "/dashboard"
@attribute [Authorize]
@inject ICurrentUserService CurrentUser
@inject StatisticsService Stats
@inject ClimbService Climbs
@inject ILogger<Dashboard> Logger

<PageTitle>Dashboard - ClimbTrack</PageTitle>
<h1>Progress dashboard</h1>

@if (_loading)
{
    <div class="text-center py-5" role="status">Loading statistics...</div>
}
else if (_error is not null)
{
    <div class="alert alert-danger" role="alert">@_error</div>
}
else if (_stats is null || _stats.TotalRecords == 0)
{
    <div class="alert alert-info">No data yet. <a href="journal">Log your first climb</a> to see your statistics.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg"><StatCard Title="Completed routes" Value="@_stats.CompletedRoutes.ToString()" Hint="Distinct routes sent" /></div>
        <div class="col-6 col-lg"><StatCard Title="Best grade" Value="@(_stats.BestGrade is { } b ? Grades.Label(b) : "-")" Hint="Highest send" /></div>
        <div class="col-6 col-lg"><StatCard Title="Sessions" Value="@_stats.SessionCount.ToString()" Hint="Distinct climbing days" /></div>
        <div class="col-6 col-lg"><StatCard Title="Total attempts" Value="@_stats.TotalAttempts.ToString()" /></div>
        <div class="col-12 col-lg"><StatCard Title="Success rate" Value="@_stats.SuccessRate.ToString("P0")" Hint="Entries that were sent" /></div>
    </div>

    <section class="card card-body mb-4">
        <h2 class="h5">Completed routes by grade</h2>
        <GradeChart Data="_stats.GradeDistribution" />
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h2 class="h5 mb-0">Recent climbs</h2>
            <a href="journal">Open journal</a>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Date</th><th>Route</th><th>Attempts</th><th>Result</th></tr></thead>
                <tbody>
                    @foreach (var c in _recent)
                    {
                        <tr @key="c.Id">
                            <td>@c.Date.ToString("yyyy-MM-dd")</td>
                            <td>@c.RouteName <GradeBadge Grade="c.Grade" /></td>
                            <td>@c.Attempts</td>
                            <td>@(c.IsCompleted ? "Sent" : "Project")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <a class="btn btn-accent" href="recommendations">Get route suggestions</a>
    </section>
}

@code {
    private DashboardStats? _stats;
    private IReadOnlyList<ClimbListItem> _recent = [];
    private bool _loading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = await CurrentUser.GetUserIdAsync();
            if (userId is null) return;
            _stats = await Stats.GetAsync(userId);
            _recent = (await Climbs.GetPageAsync(userId, 1, 5)).Items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Dashboard failed to load");
            _error = "The dashboard could not be loaded. Please try again.";
        }
        finally
        {
            _loading = false;
        }
    }
}
